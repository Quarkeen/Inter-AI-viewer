{
  "name": "AI Interviewer — Python and React",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "backend/api.py", "frontend/src/App.tsx"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "postCreateCommand": {
    "backend": "python -m pip install --user -r requirements.txt",
    "frontend": "npm ci --prefix frontend"
  },
  "portsAttributes": {
    "5173": { "label": "Interview UI", "onAutoForward": "openPreview" },
    "8000": { "label": "Interview API", "onAutoForward": "silent" }
  },
  "forwardPorts": [5173, 8000]
}
